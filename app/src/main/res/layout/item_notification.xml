<?xml version="1.0" encoding="utf-8"?>
<!-- NEW (Notifications feature): one notification row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/bg_card"
    android:layout_marginBottom="8dp">

    <TextView android:id="@+id/tvMessage" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/color_text_primary" android:textSize="14sp"/>
    <TextView android:id="@+id/tvTime" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/color_muted" android:textSize="11sp" android:layout_marginTop="4dp"/>
</LinearLayout>
