<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_rm_card"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_avatar">

            <TextView
                android:id="@+id/tvRequesterInitials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="R"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvRequesterName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requester Name"
                android:textColor="@color/text_primary"
                android:textSize="13.5sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvRouteSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For Route: Home ➔ Destination"
                android:textColor="@color/text_dim"
                android:textSize="11.5sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/tvRequestStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_rm_badge_indigo"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:text="PENDING"
            android:textColor="@color/indigo"
            android:textSize="11sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <TextView
        android:id="@+id/tvRequestNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Note: Can I join your route on Sundays?"
        android:textColor="@color/text_body"
        android:textSize="12sp"/>

    <TextView
        android:id="@+id/tvContactInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Contact: Unlocked upon acceptance"
        android:textColor="@color/text_dim"
        android:textSize="11.5sp"/>

    <!-- Respond Action Buttons for Owner -->
    <LinearLayout
        android:id="@+id/layoutOwnerActions"
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAccept"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/indigo"
            android:text="Accept"
            android:textAllCaps="false"
            android:textColor="@color/btn_on_indigo_text"
            android:textSize="12sp"
            android:textStyle="bold"
            app:cornerRadius="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReject"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="Reject"
            android:textAllCaps="false"
            android:textColor="@color/color_red"
            android:textSize="12sp"
            app:strokeColor="@color/color_red"
            app:cornerRadius="8dp"/>

    </LinearLayout>

</LinearLayout>
